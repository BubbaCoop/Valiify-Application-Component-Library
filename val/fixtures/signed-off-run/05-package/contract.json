  "fields": [
    {
      "id": "firstName",
      "label": "First name",
      "type": "text",
      "format": "free",
      "required": true,
      "placeholder": "Jane",
      "bind": "values.firstName"
    },
    {
      "id": "lastName",
      "label": "Last name",
      "type": "text",
      "format": "free",
      "required": true,
      "placeholder": "Doe",
      "bind": "values.lastName"
    },
    {
      "id": "jobTitle",
      "label": "Job title",
      "type": "text",
      "format": "free",
      "required": true,
      "placeholder": "Chief Financial Officer",
      "bind": "values.jobTitle"
    },
    {
      "id": "email",
      "label": "Email address",
      "type": "email",
      "format": "email address",
      "required": true,
      "placeholder": "jane@company.com",
      "bind": "values.email"
    },
    {
      "id": "mobile",
      "label": "Mobile phone",
      "type": "tel",
      "format": "10 digits after formatting characters are ignored",
      "required": true,
      "placeholder": "(555) 555-5555",
      "bind": "values.mobile"
    }
  ],
  "states": [
    {
      "id": "empty",
      "when": "value === \"\"",
      "prop": "value",
      "blocks": [
        "b06",
        "b07",
        "b08",
        "b09",
        "b10"
      ]
    },
    {
      "id": "error",
      "when": "touched && error !== \"\"",
      "prop": "touched",
      "blocks": [
        "b06",
        "b07",
        "b08",
        "b09",
        "b10"
      ]
    },
    {
      "id": "disabled",
      "when": "continueEnabled === false",
      "prop": "continueEnabled",
      "blocks": [
        "b11",
        "b12"
      ]
    },
    {
      "id": "enabled",
      "when": "continueEnabled === true",
      "prop": "continueEnabled",
      "blocks": [
        "b11",
        "b12"
      ]
    }
  ],
  "actions": [
    {
      "id": "back",
      "label": "Back",
      "kind": "back",
      "emits": "onback"
    },
    {
      "id": "continue",
      "label": "Continue",
      "kind": "continue",
      "enabledWhen": "isValid",
      "emits": "oncontinue"
    }
  ],
